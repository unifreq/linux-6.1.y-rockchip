	status = "okay";
};

&usb_drd0_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		usb_drd0_role_switch: endpoint@0 {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

