	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sai2m0_lrck
		     &sai2m0_sclk
		     &sai2m0_sdi
		     &sai2m0_sdo>;
};

/* io: 1v8, to 40p con & to m.2 key e */
&sai3 {
	pinctrl-names = "default";
	pinctrl-0 = <&sai3m2_lrck
		     &sai3m2_sclk
		     &sai3m2_sdi
		     &sai3m2_sdo>;
	status = "okay";
};

/* rk628 hdmirx sound */
&sai4 {
	dmas = <&dmac2 1>;
	dma-names = "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&sai4m0_lrck
		      &sai4m0_sclk
		      &sai4m0_sdi>;
	rockchip,capture-only;
	rockchip,sai-rx-wait-time-ms = <50>;
	status = "okay";
};

/* hdmitx sound */
&sai6 {
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vcca_1v8_s0>;
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs200-1_8v;
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_strb &emmc_rstnout>;
	pinctrl-names = "default";
	full-pwr-cycle-in-suspend;
	status = "okay";
};

&sdio {
	max-frequency = <200000000>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_bus4 &sdmmc1m0_clk &sdmmc1m0_cmd>;
	sd-uhs-sdr104;
	status = "disabled";
};

&sdmmc {
	max-frequency = <200000000>;
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	pinctrl-names = "default";
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3_s0>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

